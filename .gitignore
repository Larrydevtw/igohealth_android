# .gitignore #
##############
*/[Pp]lugins/android.json
*/[Pp]lugins/windows.json
*/[Pp]lugins/wp8.json
*/[Pp]lugins/remote_ios.json
![Pp]latforms/android/res
.vs/
.svn/
bin/
*.sln

*.bin
*.lock
# android platform #
###################
platforms/*/*/assets/www/
platforms/*/.idea/libraries/
platforms/*/.idea/workspace.xml
platforms/*/.idea/caches
platforms/*/CordovaLib/build
# iOS platform #
###################
platforms/*/www/
# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so
 
# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip
 
# Logs and databases #
######################
*.log
*.sql
*.sqlite
*.db
 
# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

*/*
!*/www
!*/res
!*/native
*/native/**/build/
*/native/**/.gradle/
*/native/**/.kotlin/
